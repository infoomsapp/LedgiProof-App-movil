<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ counterpart to allowBackup="false".
     supabase_flutter persists the signed in session (access and refresh
     token) in shared_preferences. With the platform default, that file is
     eligible for Google cloud backup and for device to device transfer, which
     would move a live session off this phone. Both channels are excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
